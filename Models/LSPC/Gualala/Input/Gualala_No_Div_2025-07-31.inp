c40 general watershed controls
c
c    nsubbasin   number of subwatersheds
c    nrchid      number of stream channels (corresponds with number of subwatersheds)
c    nrgid       number of stream groups to assign parameters
c    ndefid      number of land groups to assign parameters
c    ndeluid     maximum number of land use
c
c	nsws	nrch	nrgroup	nlgroup	nlandp
