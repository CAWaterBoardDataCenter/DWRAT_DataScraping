c    NumOutlets number of downstream outlets
c    DSn     downstream outlets  DS1   Ds2  ....  DSn
c           -1 = will write zero flow for that reach segment in the output timeseries
c
c	rchid	control	NumOutlets	DS1	DS2	DSn
