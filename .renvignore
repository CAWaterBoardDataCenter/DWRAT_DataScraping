# Ignore everything by default
**/**


# Un-ignore the script folders of each workflow
!W1_Watershed_Demand/Scripts
!W2_Russian_River/Scripts
!W3_LSPC_Watershed/scripts


# Un-ignore their R scripts too
!W1_Watershed_Demand/Scripts/*.R
!W2_Russian_River/Scripts/*.R
!W3_LSPC_Watershed/scripts/*.R


# Un-ignore the "Additional_Scripts" and "XLSX_Tracking" directories too
!Additional_Scripts
!Additional_Scripts/XLSX_Tracking


# Un-ignore their R scripts as well
!Additional_Scripts/*.R
!Additional_Scripts/XLSX_Tracking/*.R
